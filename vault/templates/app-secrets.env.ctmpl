{{- /* Generic KV v2 secret -> env file. Every key becomes an exported variable. */ -}}
{{- with secret (printf "secret/data/cswt/%s/%s/app-secrets" (env "NAMESPACE") (env "SERVICE")) }}
# rendered by vault agent, do not edit, do not commit
{{- range $k, $v := .Data.data }}
export {{ $k }}={{ $v | toJSON }}
{{- end }}
{{- end }}
