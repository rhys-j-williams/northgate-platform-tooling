# Local equivalent of npmrc.sample for the demo estate: Verdaccio on :4873 (PORTS.md) stands in
# for Artifactory. Same shape so the component .npmrc files and the Jenkins library work unchanged.
registry=http://localhost:4873/
//localhost:4873/:_authToken=CHANGEME-verdaccio-token
@meridian:registry=http://localhost:4873/
always-auth=false
strict-ssl=false
audit=false
fund=false
update-notifier=false
save-exact=true
