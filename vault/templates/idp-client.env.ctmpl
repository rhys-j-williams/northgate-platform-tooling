{{- /* Keystone (OIDC) confidential client. Front ends are public clients and do not get this. */ -}}
{{- with secret (printf "secret/data/cswt/%s/%s/idp-client" (env "NAMESPACE") (env "SERVICE")) }}
export OIDC_CLIENT_ID={{ .Data.data.client_id | toJSON }}
export OIDC_CLIENT_SECRET={{ .Data.data.client_secret | toJSON }}
{{- end }}
