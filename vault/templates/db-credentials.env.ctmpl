{{- /* Dynamic Postgres creds for the ledger services, static KV for the rest. The wrapper sets
       DB_CREDS_MODE. Lease renewal is handled by the agent; the app reconnects on SIGHUP. */ -}}
{{- if eq (env "DB_CREDS_MODE") "dynamic" }}
{{- with secret (printf "database/creds/%s-%s" (env "SERVICE") (env "NAMESPACE")) }}
export DB_USERNAME={{ .Data.username | toJSON }}
export DB_PASSWORD={{ .Data.password | toJSON }}
export DB_LEASE_ID={{ .LeaseID | toJSON }}
{{- end }}
{{- else }}
{{- with secret (printf "secret/data/cswt/%s/%s/db-credentials" (env "NAMESPACE") (env "SERVICE")) }}
export DB_USERNAME={{ .Data.data.username | toJSON }}
export DB_PASSWORD={{ .Data.data.password | toJSON }}
{{- end }}
{{- end }}
export DB_HOST={{ env "DB_HOST" | toJSON }}
