{{- /* Shared MQ credentials live under shared/, not under the service. See beacon-notifications.hcl. */ -}}
{{- with secret (printf "secret/data/cswt/%s/shared/mq-credentials" (env "NAMESPACE")) }}
export MQ_USER={{ .Data.data.user | toJSON }}
export MQ_PASSWORD={{ .Data.data.password | toJSON }}
export MQ_SSL_CIPHER_SUITE={{ .Data.data.cipher_suite | default "TLS_RSA_WITH_AES_256_CBC_SHA256" | toJSON }}
{{- end }}
